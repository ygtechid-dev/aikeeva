[Unit]
Description=Aikeeva AI (Next.js)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
# Folder hasil clone: /root/aikeeva
WorkingDirectory=/root/aikeeva
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=MEDIA_DIR=/root/aikeeva/.data/media
Environment=MYSQL_POOL_SIZE=10
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aikeeva

NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/root/aikeeva

[Install]
WantedBy=multi-user.target
