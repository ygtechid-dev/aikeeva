# Ganti dengan domain kamu. Caddy mengurus HTTPS otomatis (Let's Encrypt).
aikeeva.example.com {
	encode zstd gzip

	# Upload referensi start/end frame
	request_body {
		max_size 25MB
	}

	# Semua request ke Next.js (FE + API dalam satu proses)
	reverse_proxy 127.0.0.1:3000 {
		# Render video panjang: jangan putus koneksi saat polling/upload
		transport http {
			read_timeout 600s
			write_timeout 600s
			dial_timeout 10s
		}
		# Biarkan Next.js melihat skema asli (https) untuk cookie secure
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Video hasil concat dilayani route /api/media, bukan file statis,
	# jadi tidak perlu root/file_server di sini.
	log {
		output file /var/log/caddy/aikeeva.log {
			roll_size 20MB
			roll_keep 5
		}
		format console
	}
}
